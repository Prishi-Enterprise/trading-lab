# Copy to .env (git-ignored) and fill in. Real environment variables override .env.

# console | meta | twilio | callmebot
NOTIFIER=console

# Recipients for meta/twilio (comma separated, international format, no +)
WA_TO=91XXXXXXXXXX

# --- Meta WhatsApp Cloud API (official) — see docs/whatsapp.md
WA_TOKEN=
WA_PHONE_NUMBER_ID=
WA_TEMPLATE=gold_price_alert
WA_TEMPLATE_LANG=en
# WA_GRAPH_VERSION=v21.0

# --- Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=14155238886

# --- CallMeBot (free, personal, only to your own number)
CALLMEBOT_PHONE=91XXXXXXXXXX
CALLMEBOT_APIKEY=

# Optional overrides
# THRESHOLDS_PCT=-2,-5,-10,2,5,10
# GOLD_CONFIG=/path/to/config.json
# GOLD_STATE=/path/to/state.json
